{
  "name": "project-frost-wind",
  "version": "0.1.0",
  "description": "Frostwind: a nature-grounded world compiler for pixel art.",
  "license": "MIT",
  "homepage": "https://github.com/trinity-works/frostwind#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trinity-works/frostwind.git"
  },
  "bugs": {
    "url": "https://github.com/trinity-works/frostwind/issues"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:web": "node build.mjs --web",
    "dev": "node build.mjs --watch",
    "lab": "node build.mjs --lab",
    "lab:watch": "node build.mjs --lab --watch",
    "context:stats": "node tools/context-stats.mjs",
    "lint": "node tools/lint.mjs",
    "lint:fix": "node tools/lint.mjs --fix",
    "codehash": "node tools/codehash.mjs",
    "rules": "node tools/sync-rules.mjs",
    "preview": "npm run preview:capture && npm run preview:polish",
    "preview:capture": "node tools/preview.mjs --out artifacts/preview/frostwind-preview-source.mp4",
    "preview:polish": "remotion render video/index.jsx FrostwindDemo artifacts/preview/frostwind-preview.mp4 --public-dir artifacts/preview --codec h264 --audio-codec aac --crf 17",
    "preview:studio": "remotion studio video/index.jsx --public-dir artifacts/preview",
    "test": "node --test --test-reporter=dot --test-concurrency=1 \"test/**/*.test.mjs\"",
    "verify": "npm run lint && npm run build && npm test",
    "test:context": "node --test test/context-stats.test.mjs",
    "test:prose": "node --test test/prose-integrity.test.mjs test/context-stats.test.mjs",
    "test:review": "node --test test/review.test.mjs",
    "test:frame": "node --test test/frame-conformance.mjs",
    "test:palette": "node --test test/palette.test.mjs",
    "palette:update": "node test/palette-update.mjs",
    "test:scale": "node --test test/scale.test.mjs",
    "test:construct": "node --test test/construct.test.mjs",
    "test:construct:report": "FROSTWIND_TEST_REPORT=1 node --test test/construct.test.mjs",
    "test:pavilion": "node --test test/pavilion.test.mjs",
    "test:architecture": "node --test test/architecture.test.mjs",
    "test:architecture:report": "FROSTWIND_TEST_REPORT=1 node --test test/architecture.test.mjs",
    "test:built-form": "node --test test/scale.test.mjs test/construct.test.mjs test/pavilion.test.mjs test/architecture.test.mjs test/steading.test.mjs",
    "arch:update": "node test/arch-update.mjs",
    "test:gait": "node --test test/gait.test.mjs",
    "test:deer": "node --test test/gait.test.mjs test/deer.test.mjs",
    "test:wolf": "node --test test/gait.test.mjs test/wolf.test.mjs",
    "test:camel": "node --test test/gait.test.mjs test/camel.test.mjs",
    "test:machine": "node --test test/machine.test.mjs",
    "test:droop": "node --test test/droop.test.mjs",
    "test:biome": "node --test test/biome.test.mjs",
    "test:biome:report": "FROSTWIND_TEST_REPORT=1 node --test test/biome.test.mjs",
    "test:tracks": "node --test test/tracks.test.mjs",
    "test:kickup": "node --test test/kickup.test.mjs",
    "test:tracks:report": "FROSTWIND_TEST_REPORT=1 node --test test/tracks.test.mjs",
    "test:cast": "node --test test/cast.test.mjs test/resolve.test.mjs",
    "test:cast:report": "FROSTWIND_TEST_REPORT=1 node --test test/cast.test.mjs",
    "test:gear": "node --test test/gear.test.mjs",
    "test:shadeguest": "node --test test/shadeguest.test.mjs",
    "test:rig": "node --test test/skeleton.test.mjs test/shadeguest.test.mjs test/companion.test.mjs",
    "test:rig:report": "FROSTWIND_TEST_REPORT=1 node --test test/skeleton.test.mjs",
    "lineup": "node tools/lineup.mjs",
    "creature": "node tools/creature.mjs",
    "test:folk": "node --test test/folk-contract.test.mjs test/folk-raster.test.mjs test/folk-colour.test.mjs",
    "test:folk:contract": "node --test test/folk-contract.test.mjs",
    "test:folk:raster": "node --test test/folk-raster.test.mjs",
    "test:folk:colour": "node --test test/folk-colour.test.mjs",
    "test:culture": "node --test test/culture.test.mjs",
    "test:people": "node --test test/folk-contract.test.mjs test/folk-raster.test.mjs test/folk-colour.test.mjs test/culture.test.mjs test/attention.test.mjs test/cast.test.mjs test/gear.test.mjs test/resolve.test.mjs",
    "test:lighting": "node --test test/lighting.test.mjs",
    "test:reflection": "node --test test/reflection.test.mjs",
    "test:weather": "node --test test/weather.test.mjs",
    "test:desert": "node --test test/desert.test.mjs test/worm.test.mjs test/shadeguest.test.mjs",
    "test:hollow": "node --test test/hollow.test.mjs test/hollow-village.test.mjs",
    "test:worm": "node --test test/worm.test.mjs",
    "test:spell": "node --test test/spell.test.mjs",
    "test:desert:report": "FROSTWIND_TEST_REPORT=1 node --test test/desert.test.mjs",
    "test:swamp": "node --test test/swamp.test.mjs test/swamp-lakehouse.test.mjs",
    "test:swamp:report": "FROSTWIND_TEST_REPORT=1 node --test test/swamp.test.mjs test/swamp-lakehouse.test.mjs",
    "test:steading": "node --test test/steading.test.mjs",
    "test:steading:report": "FROSTWIND_TEST_REPORT=1 node --test test/steading.test.mjs",
    "test:attention": "node --test test/attention.test.mjs",
    "test:interact": "node --test test/interact.test.mjs test/scene.test.mjs",
    "test:life": "node --test test/companion.test.mjs test/life.test.mjs test/life-session.test.mjs test/ecology.test.mjs test/cohort.test.mjs test/behavior.test.mjs test/culture.test.mjs test/life-runtime.test.mjs test/disturbance.test.mjs test/expression.test.mjs",
    "test:world": "node --test test/scene.test.mjs test/palette.test.mjs test/machine.test.mjs test/tracks.test.mjs test/kickup.test.mjs test/biome.test.mjs test/lighting.test.mjs test/reflection.test.mjs test/weather.test.mjs test/swamp.test.mjs test/swamp-lakehouse.test.mjs test/desert.test.mjs test/worm.test.mjs",
    "test:music": "node --test test/music.test.mjs",
    "test:pond-court": "node --test test/pond-court.test.mjs",
    "test:lint": "node --test test/lint.test.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@remotion/cli": "^4.0.506",
    "@remotion/media": "^4.0.506",
    "esbuild": "^0.28.1",
    "playwright": "^1.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.506"
  },
  "private": true,
  "dependencies": {
    "three": "^0.160.1"
  }
}
